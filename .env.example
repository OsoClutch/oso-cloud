# Copy to .env and fill in. .env is gitignored.

# ---- Bedrock
AWS_REGION=us-east-1

# The Claude model this calls through the Converse API.
#
# There is deliberately no default in the code. Bedrock identifiers differ by
# account and region, and a cross-region inference profile has a different id
# from the model itself, so a hardcoded guess fails later as a confusing
# AccessDenied. Open the Bedrock console in your region, go to Model catalog,
# pick a Claude Haiku model, and paste the id it shows.
#
# A direct model id looks like:            anthropic.claude-haiku-...
# A cross-region inference profile adds:   us.anthropic.claude-haiku-...
BEDROCK_MODEL_ID=

# Titan Text Embeddings V2
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# ---- Retrieval
# Cosine floor for real embeddings. Below this, the pipeline refuses rather
# than guessing. Tune it until off-topic questions get "I don't know" and real
# ones still get answered, then record the value you chose.
MIN_SCORE=0.35

# Keyword-overlap floor used only in mock mode. Different scale entirely.
MIN_SCORE_MOCK=0.08

TOP_K=4

# ---- Generation
MAX_TOKENS=4096
TEMPERATURE=0.2

# ---- Run without AWS
# Set to 1 to use keyword retrieval and a fixed sample deck. The test suite
# always sets this; nothing in tests can reach AWS.
# MOCK_BEDROCK=1
